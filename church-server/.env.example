# ================================================================
# Church Management System - Backend Environment Configuration Template
# ================================================================
# Copy this file to .env for local development.
# DO NOT commit real secrets or production .env files to Git!

# 1. Server Environment
NODE_ENV=development
PORT=5000

# 2. Database Connection (MongoDB Atlas)
# In Development: Use church_db_dev (or your sandbox DB)
# In Production: Use church_db_prod
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/church_db_dev?retryWrites=true&w=majority
DB_NAME=church_db_dev

# 3. Security Secrets (Generate strong 256-bit random keys for production)
JWT_SECRET=church_dev_jwt_secret_change_in_production_12345
REFRESH_TOKEN_SECRET=church_dev_refresh_secret_change_in_production_12345

# 4. Allowed Frontend Client URLs (CORS)
FRONTEND_URL=https://sunday-school-management-system.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://sunday-school-management-system.vercel.app,https://sunday-school-management-system-u68.vercel.app

# 5. Media & Assets (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
